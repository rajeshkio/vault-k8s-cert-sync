# env.example
# Copy this file and fill in your values:
#   cp env.example mycluster.env
#
# Then run:
#   ./scripts/add-cluster.sh mycluster.env

# -- Cluster ----------------------------------------------------------------
# kubectl context name for the target cluster
CONTEXT=

# Kubernetes API server URL
KUBE_HOST=

# Vault auth mount name — use your cluster name, must be unique per cluster
MOUNT=

# Cluster type — primary or secondary
# primary   = cert-manager + cert-pusher + external-secrets roles + PushSecret
# secondary = external-secrets role only + ClusterSecretStore
TYPE=

# -- Vault ------------------------------------------------------------------ 
# URL of your Vault instance, reachable from all clusters
VAULT_URL=

# -- PushSecret (primary clusters only) ------------------------------------- 
# Name of the Kubernetes secret cert-manager creates
SECRET_NAME=

# Namespace where that secret lives
SECRET_NAMESPACE=

# Path in Vault KV where the cert will be stored
# Example: tls/rajesh-tls-cert
VAULT_PATH=
